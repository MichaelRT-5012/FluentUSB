<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluentUSB.ViewModels"
        xmlns:controls="using:FluentUSB.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="600"
        x:Class="FluentUSB.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="FluentUSB 设置"
        Icon="/Assets/app.ico"
        Width="820" Height="600"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TextOptions.TextRenderingMode="Antialias">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <!--
        版式参考 Windows 11 系统应用：左侧导航 + 右侧「分组标题 + 组内分隔行」，
        行内左侧图标与标题/说明，右侧放开关、下拉或滑块。
    -->
    <Window.Styles>
        <Style Selector="TextBlock.PageTitle">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
        <Style Selector="TextBlock.RowLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.CaptionTertiary">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.RowIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="20"/>
        </Style>

        <!-- 行卡片：每行一个独立圆角卡片，行间留 4px 间距 -->
        <Style Selector="Border.RowCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- 左侧导航项：40px 高，选中为淡填充 + 强调色细条 -->
        <Style Selector="Button.Nav">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Nav.selected">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.NavGroup">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Margin" Value="12,10,0,4"/>
        </Style>

        <!-- 选项行：整行可点，悬停/选中为弱底色 -->
        <Style Selector="RadioButton.BackdropRow">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.BackdropRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.BackdropRow:checked">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border x:Name="Surface"
            Background="{DynamicResource WindowSurfaceBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="200,*">

            <!-- 侧边栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="10,16,10,14">
                    <Grid ColumnDefinitions="Auto,*" Margin="6,0,0,6">
                        <Border Width="32" Height="32" CornerRadius="4"
                                Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                            <TextBlock Text="&#xE88E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="FluentUSB" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="设置" Classes="Caption"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="NavLayer" Grid.Row="1" Margin="0,6,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="个性化" Classes="NavGroup"/>
                            <Button x:Name="NavAppearance" Classes="Nav"
                                    Classes.selected="{Binding IsAppearanceSection}"
                                    Command="{Binding ShowAppearanceCommand}">
                                <Grid ColumnDefinitions="24,*">
                                    <TextBlock Text="&#xE790;" Classes="RowIcon" FontSize="15"/>
                                    <TextBlock Grid.Column="1" Text="外观" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <TextBlock Text="应用" Classes="NavGroup" Margin="12,14,0,4"/>
                            <Button x:Name="NavAbout" Classes="Nav"
                                    Classes.selected="{Binding IsAboutSection}"
                                    Command="{Binding ShowAboutCommand}">
                                <Grid ColumnDefinitions="24,*">
                                    <TextBlock Text="&#xE946;" Classes="RowIcon" FontSize="15"/>
                                    <TextBlock Grid.Column="1" Text="关于" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- 选中指示条：切换分类时以弹簧动画滑到目标项 -->
                        <Border x:Name="NavIndicator"
                                Width="3" Height="16" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="4,0,0,0"
                                Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding VersionText}"
                               Classes="CaptionTertiary" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Margin="32,24,32,0" Spacing="2">
                    <TextBlock Text="{Binding SectionTitle}" Classes="PageTitle"/>
                    <TextBlock Text="{Binding SectionDescription}" Classes="Caption"/>
                </StackPanel>

                <ScrollViewer x:Name="ContentScroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Margin="32,8,22,10">
                    <Panel>

                        <!-- 外观 -->
                        <StackPanel x:Name="AppearanceSection" Margin="0,0,10,8" IsVisible="True">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="00:00:00.2" Easing="CubicEaseOut"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </StackPanel.Transitions>

                            <!-- 系统能力提示 -->
                            <Border CornerRadius="4" Padding="12,10"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="&#xE946;" Classes="RowIcon" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                               Text="{Binding CapabilityText}" Classes="Caption"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,18,0,8">
                                <TextBlock Text="&#xE790;" Classes="RowIcon" FontSize="14"/>
                                <TextBlock Text="窗口与背景" Classes="GroupHeader" Margin="0"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Border Classes="RowCard">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="背景效果" Classes="RowLabel"/>
                                        <TextBlock Text="只影响主窗口与本设置页" Classes="Caption"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding BackdropOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BackdropOptionViewModel">
                                            <Border Classes="RowCard" Padding="8,2" Margin="0,0,0,4">
                                                <RadioButton GroupName="Backdrop"
                                                             Classes="BackdropRow"
                                                             IsEnabled="{Binding IsSupported}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Description}" Classes="Caption"/>
                                                        <TextBlock Text="{Binding Note}"
                                                                   Classes="CaptionTertiary"
                                                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,18,0,8">
                                <TextBlock Text="&#xE713;" Classes="RowIcon" FontSize="14"/>
                                <TextBlock Text="显示" Classes="GroupHeader" Margin="0"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Border Classes="RowCard" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="&#xE706;" Classes="RowIcon"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="背景不透明度" Classes="RowLabel"/>
                                            <TextBlock Text="越低越通透，100% 时接近纯色"
                                                       Classes="Caption"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Width="200" VerticalAlignment="Center">
                                            <controls:ValueSlider Minimum="40" Maximum="100"
                                                                 Format="{}{0:0}%"
                                                                 IsEnabled="{Binding OpacityEnabled}"
                                                                 Value="{Binding SurfaceOpacityPercent, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Classes="RowCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0" Spacing="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="主题" Classes="RowLabel"/>
                                            <TextBlock Text="跟随系统会随 Windows 深浅色自动切换"
                                                       Classes="Caption"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="160"
                                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="跟随系统"/>
                                            <ComboBoxItem Content="深色"/>
                                            <ComboBoxItem Content="浅色"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,18,0,8">
                                <TextBlock Text="&#xE88E;" Classes="RowIcon" FontSize="14"/>
                                <TextBlock Text="插入弹窗" Classes="GroupHeader" Margin="0"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Border Classes="RowCard">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="&#xE790;" Classes="RowIcon"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="绘制方式" Classes="RowLabel"/>
                                                <TextBlock Text="卡片式：圆角卡片 + 柔和阴影；整窗式：系统材质 + 系统圆角"
                                                           Classes="Caption"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <ComboBox Width="130"
                                                          SelectedIndex="{Binding ToastStyleIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="卡片式"/>
                                                    <ComboBoxItem Content="整窗式"/>
                                                </ComboBox>
                                                <Button Content="预览" Padding="12,3" FontSize="12"
                                                        Click="OnPreviewToastClick"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                <Border Classes="RowCard" IsVisible="{Binding ToastBackdropVisible}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="弹窗背景" Classes="RowLabel"/>
                                            <TextBlock Text="仅整窗式生效；卡片式始终是半透明圆角卡片"
                                                       Classes="Caption"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding ToastBackdropOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BackdropOptionViewModel">
                                                    <RadioButton GroupName="ToastBackdrop"
                                                                 Classes="BackdropRow"
                                                                 IsEnabled="{Binding IsSupported}"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="14"/>
                                                            <TextBlock Text="{Binding Description}" Classes="Caption"/>
                                                            <TextBlock Text="{Binding Note}"
                                                                       Classes="CaptionTertiary"
                                                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                    <Border Classes="RowCard" Padding="14,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="&#xE706;" Classes="RowIcon"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="弹窗不透明度" Classes="RowLabel"/>
                                                <TextBlock Text="只影响插入弹窗的底色"
                                                           Classes="Caption"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Width="200" VerticalAlignment="Center">
                                                <controls:ValueSlider Minimum="40" Maximum="100"
                                                                     Format="{}{0:0}%"
                                                                     IsEnabled="{Binding ToastOpacityEnabled}"
                                                                     Value="{Binding ToastOpacityPercent, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Classes="RowCard">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="&#xE707;" Classes="RowIcon"/>
                                            <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="停靠位置" Classes="RowLabel"/>
                                                <TextBlock Text="跟随鼠标所在屏幕显示" Classes="Caption"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2" Width="160"
                                                      SelectedIndex="{Binding PopupPositionIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="左下角"/>
                                                <ComboBoxItem Content="右下角"/>
                                                <ComboBoxItem Content="左上角"/>
                                                <ComboBoxItem Content="右上角"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Classes="RowCard" Padding="14,12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,16,0" Spacing="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="停留时长" Classes="RowLabel"/>
                                                <TextBlock Text="悬停时暂停倒计时" Classes="Caption"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Width="200" VerticalAlignment="Center">
                                                <controls:ValueSlider Minimum="2" Maximum="30"
                                                                     Format="{}{0:0} 秒"
                                                                     Value="{Binding PopupDurationSeconds, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                        </StackPanel>

                        <!-- 关于 -->
                        <StackPanel x:Name="AboutSection" Margin="0,0,10,8" IsVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="00:00:00.2" Easing="CubicEaseOut"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </StackPanel.Transitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                                <TextBlock Text="&#xE946;" Classes="RowIcon" FontSize="14"/>
                                <TextBlock Text="应用信息" Classes="GroupHeader" Margin="0"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Border Classes="RowCard" Padding="16">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="44" Height="44" CornerRadius="4"
                                                Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                                            <TextBlock Text="&#xE88E;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="22" Foreground="#FFFFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0"
                                                    VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="FluentUSB" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AboutDescription}" Classes="Caption"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Classes="RowCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="运行系统"
                                                   Classes="RowLabel" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SystemText}"
                                                   Classes="Caption" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Classes="RowCard">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="构建时间"
                                                   Classes="RowLabel" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BuildText}"
                                                   Classes="Caption" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="文件位置" Classes="GroupHeader" Margin="2,18,0,8"/>
                            <StackPanel Spacing="4">
                                <Border Classes="RowCard">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="设置文件" Classes="RowLabel"/>
                                        <SelectableTextBlock Text="{Binding SettingsFilePath}"
                                                             Classes="Caption"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="RowCard">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="日志目录" Classes="RowLabel"/>
                                        <SelectableTextBlock Text="{Binding LogFolderPath}"
                                                             Classes="Caption"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="RowCard">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="下一步" Classes="RowLabel"/>
                                        <TextBlock Classes="Caption"
                                                   Text="列出 U 盘根目录的最新课件，支持多选后按科目一键复制并打开目标文件夹。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>

                <!-- 底部操作 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="32,12,24,16">
                        <Button Content="恢复默认" Command="{Binding ResetDefaultsCommand}"
                                IsVisible="{Binding IsAppearanceSection}"/>
                        <Button Grid.Column="2" Content="关闭" Click="OnCloseClick"
                                MinWidth="88" Classes="accent"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
