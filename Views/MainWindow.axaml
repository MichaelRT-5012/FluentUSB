<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluentUSB.ViewModels"
        xmlns:controls="using:FluentUSB.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="360"
        Width="460" Height="360"
        MinWidth="400" MinHeight="260"
        x:Class="FluentUSB.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="FluentUSB"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TextOptions.TextRenderingMode="Antialias">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!--
        与设置窗口共用 ClassIsland 的视觉语言：
        列表项按 SettingsExpander 的规格做成 4px 圆角卡片（1px 描边 + 16 内边距），
        图标 20px 一列，标题 14，说明 12，操作区靠右对齐。
    -->
    <Window.Styles>
        <!-- 文件列表卡片：Win11 的卡片规格与 ClassIsland 设置行一致 -->
        <Style Selector="Border.DriveCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.DriveRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DriveRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.DriveRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <!-- 图标按钮：与 Win11 标题栏/命令栏按钮一致，悬停才有底色 -->
        <Style Selector="Button.IconOnly">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconOnly:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.RowIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <!-- 卡片底色叠在系统背景效果之上：避免壁纸背景下文字看不清 -->
    <Border x:Name="Surface" Background="{DynamicResource WindowSurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="20,18,20,14"
              controls:IntroAnimation.Enabled="True">

            <!-- 应用标识 + 监听状态 -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="32" Height="32" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE88E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" Classes="SubtitleText"/>
                    <TextBlock Text="{Binding Subtitle}" Classes="Caption"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!-- 调试入口：连点主窗口 5 次后出现，点击插入内置示例 U 盘 -->
                    <Button Classes="IconOnly" ToolTip.Tip="插入示例 U 盘"
                            IsVisible="{Binding IsDemoRevealed}"
                            Command="{Binding AddDemoDriveCommand}">
                        <TextBlock Text="&#xE88E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemControlBackgroundAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="IconOnly" ToolTip.Tip="设置" Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="2,18,0,8">
                <TextBlock Text="&#xE88E;" Classes="RowIcon"/>
                <TextBlock Text="已连接的 U 盘" Classes="BodyStrong"/>
            </StackPanel>

            <!-- 列表 / 空状态 -->
            <Grid Grid.Row="2">
                <ScrollViewer IsVisible="{Binding HasDrives}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DriveList}" Margin="0,0,-6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsbDriveViewModel">
                                <Border Classes="DriveCard" Margin="0,0,0,4">
                                    <Button Classes="DriveRow" Command="{Binding OpenDriveCommand}"
                                            ToolTip.Tip="打开">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

                                            <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Opacity="0.14"
                                                        Background="{DynamicResource SystemControlBackgroundAccentBrush}"/>
                                                <TextBlock Text="&#xE88E;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource SystemControlBackgroundAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="16,0,8,0" Spacing="2"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="4" Padding="6,1"
                                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DriveLetter}" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding SizeSummary}"/><Run Text=" · "/><Run Text="{Binding FormatText}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel IsVisible="{Binding !HasDrives}" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE88E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="还没有连接 U 盘" FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
