<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluentUSB.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="360"
        Width="460" Height="360"
        MinWidth="400" MinHeight="260"
        x:Class="FluentUSB.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="FluentUSB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TextOptions.TextRenderingMode="Antialias">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- 文件列表行：Win11 的列表项就是 4px 圆角 + 悬停时一层很淡的填充 -->
        <Style Selector="Button.DriveRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DriveRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.DriveRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <!-- 图标按钮：与 Win11 标题栏/命令栏按钮一致，悬停才有底色 -->
        <Style Selector="Button.IconOnly">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconOnly:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <!-- 文字层级：标题 20 / 正文 14 / 说明 12 -->
        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.CardHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <!-- 卡片底色叠在系统背景效果之上：避免壁纸背景下文字看不清 -->
    <Border x:Name="Surface" Background="{DynamicResource WindowSurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,18,20,14">

            <!-- 标题 + 监听状态 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Classes="Caption"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Classes="IconOnly" ToolTip.Tip="设置" Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Margin="2,18,0,8" Text="已连接的 U 盘"
                       Classes="CardHeader"/>

            <!-- 列表 / 空状态 -->
            <Grid Grid.Row="2">
                <ScrollViewer IsVisible="{Binding HasDrives}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DriveList}" Margin="0,0,-6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsbDriveViewModel">
                                <Button Classes="DriveRow" Command="{Binding OpenDriveCommand}"
                                        Margin="0,0,0,2" ToolTip.Tip="在资源管理器中打开">
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Opacity="0.14"
                                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}"/>
                                            <TextBlock Text="&#xE88E;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource SystemControlBackgroundAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Border CornerRadius="4" Padding="6,1"
                                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DriveLetter}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SizeSummary}"/><Run Text=" · "/><Run Text="{Binding FormatText}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel IsVisible="{Binding !HasDrives}" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE88E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="还没有连接 U 盘" FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="插入后会自动弹出提示，也可以从托盘菜单打开本窗口"
                               FontSize="12" MaxWidth="280"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Margin="2,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="点击列表中的 U 盘可在资源管理器中打开"/>
        </Grid>
    </Border>
</Window>
