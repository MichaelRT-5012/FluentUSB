<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FluentUSB.App"
             xmlns:controls="using:FluentUSB.Controls">
             <!-- 主题与窗口背景由设置页控制（%AppData%\FluentUSB\settings.json） -->

    <!--
        颜色令牌尽量沿用 WinUI 3 的同名资源与取值（Windows 11 系统应用就是这一套），
        这样圆角、描边、悬停与文字层级能和系统界面保持一致，而不是自拟配色。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!--
                内置 HarmonyOS Sans SC（与 ClassIsland 使用同一套字体族），
                Regular/Medium 两个字重已打包进 Assets/Fonts，许可文本见同目录 LICENSE.txt。
            -->
            <FontFamily x:Key="AppFont">avares://FluentUSB/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!--
                        强调色：DodgerBlue，严格对齐 ClassIsland 的 CustomAccentColor="DodgerBlue"。
                        覆盖 Avalonia FluentTheme 的 SystemAccentColor，令 Slider/CheckBox
                        单选、ComboBox 选中与强调按钮统一变为 ClassIsland 的蓝色。
                    -->
                    <Color x:Key="SystemAccentColor">#1E90FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#1A82E6</Color>
                    <Color x:Key="SystemAccentColorDark2">#1671CC</Color>
                    <Color x:Key="SystemAccentColorDark3">#1259A6</Color>
                    <Color x:Key="SystemAccentColorLight1">#4CA6FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#7ABDFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#A8D4FF</Color>
                    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1E90FF" />
                    <!-- 窗口底色（无系统材质时的纯色底） -->
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F3F3F3" />
                    <!-- 侧边栏/导航背景层 -->
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4CFFFFFF" />
                    <!-- 设置卡片 -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
                    <!-- 菜单浮层：90% 不透明，避免透出下方内容 -->
                    <SolidColorBrush x:Key="MenuCardBackgroundBrush" Color="#E6F9F9F9" />
                    <!-- 文件行选中态：强调色低透明度衬底 -->
                    <SolidColorBrush x:Key="FileSelectionBrush" Color="#331E90FF" />
                    <!-- 控件填充与描边 -->
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
                    <!-- 文字层级 -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
                    <!-- 悬停/选中等弱背景 -->
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- 强调色：DodgerBlue（暗色下保持一致，与 ClassIsland 相同） -->
                    <Color x:Key="SystemAccentColor">#1E90FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#1A82E6</Color>
                    <Color x:Key="SystemAccentColorDark2">#1671CC</Color>
                    <Color x:Key="SystemAccentColorDark3">#1259A6</Color>
                    <Color x:Key="SystemAccentColorLight1">#4CA6FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#7ABDFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#A8D4FF</Color>
                    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1E90FF" />
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#202020" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />
                    <!-- 菜单浮层：90% 不透明，避免透出下方内容 -->
                    <SolidColorBrush x:Key="MenuCardBackgroundBrush" Color="#E62B2B2B" />
                    <!-- 文件行选中态：强调色低透明度衬底 -->
                    <SolidColorBrush x:Key="FileSelectionBrush" Color="#4D1E90FF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--
            全局版式令牌对齐 ClassIsland：HarmonyOS Sans SC + WinUI 字号层级，
            标题 28 / 副标题 20 / 正文 14 / 说明 12。
        -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        </Style>
        <Style Selector="TextBlock.TitleText">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.SubtitleText">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.BodyStrong">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 分组之间的细分隔线（对应 ClassIsland 设置页的 Separator Margin="0 12 0 4"） -->
        <Style Selector="Border.SectionDivider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <!--
            设置页版式容器：对齐 ClassIsland 的 StackPanel.settings-container
            （Margin "12 12 18 12" + Spacing 4 + MaxWidth 960）。
        -->
        <Style Selector="StackPanel.settings-container">
            <Setter Property="Margin" Value="12,12,18,12"/>
            <Setter Property="Spacing" Value="4"/>
        </Style>

        <!-- 分组标题：对齐 ClassIsland 的 IconText（16px 图标 + 14px 中等字重标题） -->
        <Style Selector="TextBlock.GroupIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 通用控件：圆角、字号与最小点击尺寸（触屏也能稳定点中） -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="32"/>
            <!-- Avalonia 12 的 Button 默认内容左对齐，这里统一改为居中 -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 统一的交互反馈：悬停/按下的底色按 WinUI 的 167ms 平滑过渡 -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="controls:ComboPopupMotion.Enabled" Value="True"/>
        </Style>
        <!-- 下拉项：与 Win11 弹出层一致，圆角 + 内缩 2px -->
        <Style Selector="ComboBoxItem">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- 下拉浮层本体：8px 圆角（Win11 浮层规格） -->
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="CheckBox, RadioButton">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Application.Styles>

    <!-- 托盘图标：左键 Clicked 恢复主窗口，右键弹出菜单 -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/app.ico"
                      ToolTipText="FluentUSB"
                      Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="设置" Click="OnSettingsMenuClick" />
                        <NativeMenuItem Header="显示主窗口" Click="OnShowMainWindowClick" />
                        <NativeMenuItem Header="退出" Click="OnExitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
