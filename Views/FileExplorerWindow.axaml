<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluentUSB.ViewModels"
        xmlns:models="using:FluentUSB.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="620"
        x:Class="FluentUSB.Views.FileExplorerWindow"
        x:DataType="vm:FileExplorerViewModel"
        Icon="/Assets/app.ico"
        Width="920" Height="620"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="OnWindowKeyDown"
        TextOptions.TextRenderingMode="Antialias">

    <!--
        内建文件浏览器（M2）：工具栏 + 可点击排序的表头 + 文件列表。
        视觉语言与主窗口/设置页一致：卡片圆角、Win11 文字层级、强调色 DodgerBlue。
    -->
    <Window.Styles>
        <!-- 表头列：整列可点，悬停有弱底色，字号 12 + 次要文字色 -->
        <Style Selector="Button.ColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ColumnHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.ColumnHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.ColumnTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SortGlyph">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 列宽拖拽手柄：压在列边界上，悬停显示强调色细线 -->
        <Style Selector="Border.ColumnGrip">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,0,-4,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
        </Style>
        <Style Selector="Border.ColumnGrip > Border">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="00:00:00.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ColumnGrip:pointerover > Border">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- 顶部命令栏按钮（Win11 资源管理器风格：图标 + 文字） -->
        <Style Selector="Button.CommandButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.CommandButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.CommandButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.CommandButton.open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.CommandIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.CommandText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 导航按钮：后退 / 上一级 / 刷新 -->
        <Style Selector="Button.NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.NavIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.MenuChevron">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 菜单浮层 -->
        <Style Selector="Border.MenuCard">
            <Setter Property="Background" Value="{DynamicResource MenuCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="BoxShadow" Value="0 8 24 -8 #66000000"/>
        </Style>
        <Style Selector="Button.MenuRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.MenuRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.MenuRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <!-- 禁用的菜单项：只让文字变灰，不改变整行背景 -->
        <Style Selector="Button.MenuRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.MenuRow:disabled TextBlock.MenuText">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
        </Style>
        <Style Selector="Button.MenuRow:disabled TextBlock.MenuIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
        </Style>
        <Style Selector="TextBlock.MenuCheck">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.MenuText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.MenuIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.MenuSeparator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        </Style>
        <Style Selector="TextBlock.MenuSubChevron">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                  Duration="00:00:00.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.MenuSubChevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
        </Style>

        <!-- 二级菜单「分组依据」：高度 + 透明度平滑展开/收起 -->
        <Style Selector="Border.GroupBySection">
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="00:00:00.18" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="00:00:00.16"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 分组内容区：展开/收起时高度与透明度平滑过渡 -->
        <Style Selector="Border.GroupContent">
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="00:00:00.22" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="00:00:00.16"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 窗口内的确认 / 输入浮层 -->
        <Style Selector="Border.DialogCard">
            <Setter Property="Background" Value="{DynamicResource MenuCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 12 32 -8 #66000000"/>
        </Style>

        <!-- 文件行 -->
        <Style Selector="Border.FileRow">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FileRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.FileRow.selected">
            <Setter Property="Background" Value="{DynamicResource FileSelectionBrush}"/>
        </Style>
        <!-- 拖放悬停到文件夹行时的提示 -->
        <Style Selector="Border.FileRow.dropTarget">
            <Setter Property="Background" Value="{DynamicResource FileSelectionBrush}"/>
        </Style>
        <Style Selector="TextBlock.ItemIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.ItemIcon.folder">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.CellText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.NameText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 分组标题行：整行可点，折叠时箭头转向 -->
        <Style Selector="Button.GroupHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="00:00:00.167"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.GroupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.GroupChevron">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.GroupChevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
        </Style>
    </Window.Styles>

    <!-- 文件行与分组行的模板：外层列表与分组内嵌列表共用 -->
    <Window.DataTemplates>
        <!-- 文件 / 文件夹行 -->
        <DataTemplate DataType="models:FileEntry" x:DataType="models:FileEntry">
            <Border Classes="FileRow" Classes.selected="{Binding IsSelected}"
                    PointerPressed="OnRowPressed"
                    PointerMoved="OnRowPointerMoved"
                    PointerReleased="OnRowPointerReleased"
                    PointerCaptureLost="OnRowPointerCaptureLost"
                    DoubleTapped="OnRowDoubleTapped">
                <Grid Height="38" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding $parent[Window].((vm:FileExplorerViewModel)DataContext).NameColumnWidth}"/>
                        <ColumnDefinition Width="{Binding $parent[Window].((vm:FileExplorerViewModel)DataContext).ModifiedColumnWidth}"/>
                        <ColumnDefinition Width="{Binding $parent[Window].((vm:FileExplorerViewModel)DataContext).TypeColumnWidth}"/>
                        <ColumnDefinition Width="{Binding $parent[Window].((vm:FileExplorerViewModel)DataContext).SizeColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IconGlyph}" Classes="ItemIcon"
                                   Classes.folder="{Binding IsDirectory}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   Margin="10,0,8,0" Classes="NameText"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding ModifiedText}"
                               Classes="CellText"/>
                    <TextBlock Grid.Column="2" Text="{Binding TypeText}"
                               Classes="CellText"/>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                               Classes="CellText" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 分组：标题行 + 可折叠内容区（高度过渡完成展开/收起） -->
        <DataTemplate DataType="vm:FileGroupRow" x:DataType="vm:FileGroupRow">
            <StackPanel>
                <Button Classes="GroupHeader" Click="OnGroupHeaderClick"
                        ToolTip.Tip="折叠或展开此分组">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
                        <TextBlock Text="&#xE70D;" Classes="GroupChevron"
                                   Classes.collapsed="{Binding !IsExpanded}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   Margin="10,0,8,0" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Button>
                <Border Classes="GroupContent"
                        Height="{Binding ExpandedHeight}" Opacity="{Binding ContentOpacity}">
                    <ItemsControl ItemsSource="{Binding Entries}"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Border x:Name="Surface" Background="{DynamicResource WindowSurfaceBrush}"
            DragDrop.AllowDrop="True">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- 工具栏：导航 + 盘符标识 + 盘名 + 当前路径，右侧项目数 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,10">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="NavButton" Click="OnGoBackClick"
                                IsEnabled="{Binding CanGoBack}" ToolTip.Tip="后退">
                            <TextBlock Text="&#xE72B;" Classes="NavIcon"/>
                        </Button>
                        <Button Classes="NavButton" Click="OnGoUpClick"
                                IsEnabled="{Binding CanGoUp}" ToolTip.Tip="上一级">
                            <TextBlock Text="&#xE74A;" Classes="NavIcon"/>
                        </Button>
                        <Button Classes="NavButton" Command="{Binding RefreshCommand}"
                                ToolTip.Tip="刷新">
                            <TextBlock Text="&#xE72C;" Classes="NavIcon"/>
                        </Button>
                    </StackPanel>

                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                        <Border CornerRadius="6" Opacity="0.14"
                                Background="{DynamicResource SystemControlBackgroundAccentBrush}"/>
                        <TextBlock Text="&#xE88E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource SystemControlBackgroundAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DriveName}" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border CornerRadius="4" Padding="6,1"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DriveLetter}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PathText}" Classes="Caption"
                                   MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ItemCountText}" Classes="Caption"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 顶部命令栏：常用操作 + 排序 / 查看菜单（图标与 Win11 资源管理器一致） -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="16,0,16,4">
                <Button Classes="CommandButton" Command="{Binding NewFolderCommand}"
                        ToolTip.Tip="新建文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8F4;" Classes="CommandIcon"/>
                        <TextBlock Text="新建文件夹" Classes="CommandText"/>
                    </StackPanel>
                </Button>
                <Button Classes="CommandButton" Command="{Binding CutCommand}" ToolTip.Tip="剪切">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8C6;" Classes="CommandIcon"/>
                        <TextBlock Text="剪切" Classes="CommandText"/>
                    </StackPanel>
                </Button>
                <Button Classes="CommandButton" Command="{Binding CopyCommand}" ToolTip.Tip="复制">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8C8;" Classes="CommandIcon"/>
                        <TextBlock Text="复制" Classes="CommandText"/>
                    </StackPanel>
                </Button>
                <Button Classes="CommandButton" Command="{Binding PasteCommand}" ToolTip.Tip="粘贴">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE77F;" Classes="CommandIcon"/>
                        <TextBlock Text="粘贴" Classes="CommandText"/>
                    </StackPanel>
                </Button>
                <Button Classes="CommandButton" Command="{Binding RenameCommand}" ToolTip.Tip="重命名">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8AC;" Classes="CommandIcon"/>
                        <TextBlock Text="重命名" Classes="CommandText"/>
                    </StackPanel>
                </Button>
                <Button Classes="CommandButton" Command="{Binding DeleteCommand}" ToolTip.Tip="删除">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE74D;" Classes="CommandIcon"/>
                        <TextBlock Text="删除" Classes="CommandText"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="6,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                <Button x:Name="SortMenuButton" Classes="CommandButton" Click="OnSortMenuClick"
                        ToolTip.Tip="排序">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8CB;" Classes="CommandIcon"/>
                        <TextBlock Text="排序" Classes="CommandText"/>
                        <TextBlock Text="&#xE70D;" Classes="MenuChevron"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ViewMenuButton" Classes="CommandButton" Click="OnViewMenuClick"
                        ToolTip.Tip="查看">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE890;" Classes="CommandIcon"/>
                        <TextBlock Text="查看" Classes="CommandText"/>
                        <TextBlock Text="&#xE70D;" Classes="MenuChevron"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 排序菜单浮层 -->
            <Popup x:Name="SortPopup" Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True" VerticalOffset="2"
                   Opened="OnMenuPopupOpened">
                <Border x:Name="SortPopupCard" Classes="MenuCard">
                    <StackPanel>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding SortByCommand}" CommandParameter="Name">
                            <Grid ColumnDefinitions="20,*">
                                <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                           IsVisible="{Binding IsNameSorted}"/>
                                <TextBlock Grid.Column="1" Text="名称" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding SortByCommand}" CommandParameter="Modified">
                            <Grid ColumnDefinitions="20,*">
                                <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                           IsVisible="{Binding IsModifiedSorted}"/>
                                <TextBlock Grid.Column="1" Text="修改时间" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding SortByCommand}" CommandParameter="Type">
                            <Grid ColumnDefinitions="20,*">
                                <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                           IsVisible="{Binding IsTypeSorted}"/>
                                <TextBlock Grid.Column="1" Text="类型" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding SortByCommand}" CommandParameter="Size">
                            <Grid ColumnDefinitions="20,*">
                                <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                           IsVisible="{Binding IsSizeSorted}"/>
                                <TextBlock Grid.Column="1" Text="大小" Classes="MenuText"/>
                            </Grid>
                        </Button>

                        <Border Classes="MenuSeparator"/>

                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding SortAscendingCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                           IsVisible="{Binding IsAscending}"/>
                                <TextBlock Grid.Column="1" Text="递增" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding SortDescendingOrderCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                           IsVisible="{Binding IsDescending}"/>
                                <TextBlock Grid.Column="1" Text="递减" Classes="MenuText"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 查看菜单浮层：分组依据为可展开的二级菜单 -->
            <Popup x:Name="ViewPopup" Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True" VerticalOffset="2"
                   Opened="OnMenuPopupOpened">
                <Border x:Name="ViewPopupCard" Classes="MenuCard" MinWidth="220">
                    <StackPanel>
                        <Button Classes="MenuRow" Click="OnGroupByRowClick">
                            <Grid ColumnDefinitions="20,*,Auto">
                                <TextBlock Text="&#xE8B7;" Classes="MenuCheck" Opacity="0"/>
                                <TextBlock Grid.Column="1" Text="分组依据" Classes="MenuText"/>
                                <TextBlock x:Name="GroupByChevron" Grid.Column="2"
                                           Text="&#xE76C;" Classes="MenuSubChevron"/>
                            </Grid>
                        </Button>

                        <Border x:Name="GroupBySection" Classes="GroupBySection">
                            <StackPanel Margin="0,2,0,2">
                                <Button Classes="MenuRow" Padding="28,6" Click="OnMenuActionClick"
                                        Command="{Binding SetGroupByCommand}" CommandParameter="None">
                                    <Grid ColumnDefinitions="20,*">
                                        <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                                   IsVisible="{Binding IsGroupedByNone}"/>
                                        <TextBlock Grid.Column="1" Text="无" Classes="MenuText"/>
                                    </Grid>
                                </Button>
                                <Button Classes="MenuRow" Padding="28,6" Click="OnMenuActionClick"
                                        Command="{Binding SetGroupByCommand}" CommandParameter="Name">
                                    <Grid ColumnDefinitions="20,*">
                                        <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                                   IsVisible="{Binding IsGroupedByName}"/>
                                        <TextBlock Grid.Column="1" Text="名称" Classes="MenuText"/>
                                    </Grid>
                                </Button>
                                <Button Classes="MenuRow" Padding="28,6" Click="OnMenuActionClick"
                                        Command="{Binding SetGroupByCommand}" CommandParameter="Modified">
                                    <Grid ColumnDefinitions="20,*">
                                        <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                                   IsVisible="{Binding IsGroupedByModified}"/>
                                        <TextBlock Grid.Column="1" Text="修改时间" Classes="MenuText"/>
                                    </Grid>
                                </Button>
                                <Button Classes="MenuRow" Padding="28,6" Click="OnMenuActionClick"
                                        Command="{Binding SetGroupByCommand}" CommandParameter="Type">
                                    <Grid ColumnDefinitions="20,*">
                                        <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                                   IsVisible="{Binding IsGroupedByType}"/>
                                        <TextBlock Grid.Column="1" Text="类型" Classes="MenuText"/>
                                    </Grid>
                                </Button>
                                <Button Classes="MenuRow" Padding="28,6" Click="OnMenuActionClick"
                                        Command="{Binding SetGroupByCommand}" CommandParameter="Size">
                                    <Grid ColumnDefinitions="20,*">
                                        <TextBlock Text="&#xE73E;" Classes="MenuCheck"
                                                   IsVisible="{Binding IsGroupedBySize}"/>
                                        <TextBlock Grid.Column="1" Text="大小" Classes="MenuText"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="MenuSeparator"/>

                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding ExpandAllGroupsCommand}">
                            <TextBlock Text="展开所有分组" Classes="MenuText" Margin="20,0,0,0"/>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding CollapseAllGroupsCommand}">
                            <TextBlock Text="折叠所有分组" Classes="MenuText" Margin="20,0,0,0"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 文件 / 空白处右键菜单（触屏长按同样弹出） -->
            <Popup x:Name="RowMenuPopup" Placement="Pointer" IsLightDismissEnabled="True"
                   HorizontalOffset="4" VerticalOffset="4"
                   Opened="OnMenuPopupOpened">
                <Border Classes="MenuCard" MinWidth="200">
                    <StackPanel>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding OpenSelectedCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE8E5;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="打开" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Border Classes="MenuSeparator"/>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding CutCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE8C6;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="剪切" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding CopyCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE8C8;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="复制" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding PasteCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE77F;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="粘贴" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Border Classes="MenuSeparator"/>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding RenameCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE8AC;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="重命名" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding DeleteCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE74D;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="删除" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Border Classes="MenuSeparator"/>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding NewFolderCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE8F4;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="新建文件夹" Classes="MenuText"/>
                            </Grid>
                        </Button>
                        <Button Classes="MenuRow" Click="OnMenuActionClick"
                                Command="{Binding RefreshCommand}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="&#xE72C;" Classes="MenuIcon"/>
                                <TextBlock Grid.Column="1" Text="刷新" Classes="MenuText"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 表头：点击列名切换升/降序，拖动列边界调整列宽；列宽与文件行共用 -->
            <Border Grid.Row="2" Margin="16,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="HeaderGrid" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding NameColumnWidth}"/>
                        <ColumnDefinition Width="{Binding ModifiedColumnWidth}"/>
                        <ColumnDefinition Width="{Binding TypeColumnWidth}"/>
                        <ColumnDefinition Width="{Binding SizeColumnWidth}"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Button Classes="ColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="Name" ToolTip.Tip="按名称排序">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="名称" Classes="ColumnTitle"/>
                                <TextBlock Text="{Binding NameSortGlyph}" Classes="SortGlyph"
                                           IsVisible="{Binding IsNameSorted}"/>
                            </StackPanel>
                        </Button>
                        <Border Classes="ColumnGrip" Tag="Name"
                                ToolTip.Tip="拖动调整列宽"
                                PointerPressed="OnGripPressed" PointerMoved="OnGripMoved"
                                PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost">
                            <Border Width="1" Margin="0,6"
                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                    HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Button Classes="ColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="Modified" ToolTip.Tip="按修改时间排序">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="修改时间" Classes="ColumnTitle"/>
                                <TextBlock Text="{Binding ModifiedSortGlyph}" Classes="SortGlyph"
                                           IsVisible="{Binding IsModifiedSorted}"/>
                            </StackPanel>
                        </Button>
                        <Border Classes="ColumnGrip" Tag="Modified"
                                ToolTip.Tip="拖动调整列宽"
                                PointerPressed="OnGripPressed" PointerMoved="OnGripMoved"
                                PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost">
                            <Border Width="1" Margin="0,6"
                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                    HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Button Classes="ColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="Type" ToolTip.Tip="按类型排序">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="类型" Classes="ColumnTitle"/>
                                <TextBlock Text="{Binding TypeSortGlyph}" Classes="SortGlyph"
                                           IsVisible="{Binding IsTypeSorted}"/>
                            </StackPanel>
                        </Button>
                        <Border Classes="ColumnGrip" Tag="Type"
                                ToolTip.Tip="拖动调整列宽"
                                PointerPressed="OnGripPressed" PointerMoved="OnGripMoved"
                                PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost">
                            <Border Width="1" Margin="0,6"
                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                    HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="3">
                        <Button Classes="ColumnHeader" HorizontalContentAlignment="Right"
                                Command="{Binding SortByCommand}"
                                CommandParameter="Size" ToolTip.Tip="按大小排序">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="大小" Classes="ColumnTitle"/>
                                <TextBlock Text="{Binding SizeSortGlyph}" Classes="SortGlyph"
                                           IsVisible="{Binding IsSizeSorted}"/>
                            </StackPanel>
                        </Button>
                        <Border Classes="ColumnGrip" Tag="Size"
                                ToolTip.Tip="拖动调整列宽"
                                PointerPressed="OnGripPressed" PointerMoved="OnGripMoved"
                                PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost">
                            <Border Width="1" Margin="0,6"
                                    Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                                    HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 文件列表 / 空状态 -->
            <Grid Grid.Row="3" Margin="16,6,16,12" PointerPressed="OnListBackgroundPressed">
                <ScrollViewer IsVisible="{Binding HasItems}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FileList" ItemsSource="{Binding Items}"/>
                </ScrollViewer>

                <StackPanel IsVisible="{Binding !HasItems}" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding EmptyHint}" FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 文件操作进度浮层（复制 / 移动 / 删除） -->
            <Grid Grid.RowSpan="4" Panel.ZIndex="20" IsVisible="{Binding IsOperationInProgress}"
                  Background="#66000000">
                <Border Classes="DialogCard" Width="430"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding OperationTitle}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OperationDetail}" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 进度条：圆角轨道 + 强调色渐变填充 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Height="8" CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <ProgressBar Minimum="0" Maximum="100" Height="8"
                                             Background="Transparent"
                                             Value="{Binding OperationPercent}"
                                             IsIndeterminate="{Binding IsOperationIndeterminate}">
                                    <ProgressBar.Foreground>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#1E90FF" Offset="0"/>
                                            <GradientStop Color="#5CC8FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ProgressBar.Foreground>
                                </ProgressBar>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding OperationPercentText}"
                                       MinWidth="42" TextAlignment="Right" Margin="10,0,0,0"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 项目数 / 已写入大小 / 实时速度 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding OperationItemsText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding OperationSizeText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding OperationSpeedText}" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="当前速度" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{Binding OperationPauseText}" MinWidth="80"
                                    IsVisible="{Binding CanPauseOperation}"
                                    Command="{Binding TogglePauseOperationCommand}"/>
                            <Button Content="取消" MinWidth="80"
                                    IsVisible="{Binding CanCancelOperation}"
                                    Command="{Binding CancelOperationCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 删除确认浮层 -->
            <Grid Grid.RowSpan="4" Panel.ZIndex="10" IsVisible="{Binding IsDeletePromptVisible}"
                  Background="#66000000">
                <Border Classes="DialogCard" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <TextBlock Text="删除项目" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DeletePromptText}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" MinWidth="80"
                                    Command="{Binding CancelDeleteCommand}"/>
                            <Button Content="删除" MinWidth="80"
                                    Command="{Binding ConfirmDeleteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 重命名浮层 -->
            <Grid Grid.RowSpan="4" Panel.ZIndex="10" IsVisible="{Binding IsRenamePromptVisible}"
                  Background="#66000000">
                <Border Classes="DialogCard" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <TextBlock Text="重命名" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="RenameBox" Text="{Binding RenameText, Mode=TwoWay}"
                                 FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" MinWidth="80"
                                    Command="{Binding CancelRenameCommand}"/>
                            <Button Content="确定" MinWidth="80"
                                    Command="{Binding ConfirmRenameCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
