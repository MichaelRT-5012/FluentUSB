<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluentUSB.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="108"
        x:Class="FluentUSB.Views.UsbToastWindow"
        x:DataType="vm:UsbDriveViewModel"
        Title="USB 提示"
        Width="360" Height="108"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        TextOptions.TextRenderingMode="Antialias"
        Cursor="Hand">

    <Window.Styles>
        <!-- 入场/退场动画：淡入 + 上浮；鼠标悬停轻微放大 -->
        <Style Selector="Border#RootCard">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(24px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="00:00:00.22" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.26" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#RootCard.Show">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="Border#RootCard.Show:pointerover">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1.015)"/>
        </Style>
    </Window.Styles>

    <!-- 外层留 8px 给阴影，避免被窗口边界裁掉 -->
    <Border x:Name="RootCard" Margin="8" CornerRadius="14"
            Background="{DynamicResource CardSurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 10 30 -12 #80000000">
        <Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14">

                <!-- U 盘图标 -->
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE88E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="22" Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 盘名 / 盘符 / 容量 -->
                <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="15" FontWeight="SemiBold"
                                   MaxWidth="170" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DriveLetter}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SizeSummary}"/><Run Text=" · "/><Run Text="{Binding FormatText}"/>
                    </TextBlock>
                    <TextBlock Text="点击打开 U 盘" FontSize="11" Opacity="0.5"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="&#xE76C;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Opacity="0.6"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 自动关闭倒计时条 -->
            <ProgressBar x:Name="Countdown" Height="3" Minimum="0" Maximum="100" Value="100"
                         VerticalAlignment="Bottom" Margin="1,0,1,1"
                         Foreground="{DynamicResource SystemControlBackgroundAccentBrush}"
                         Background="Transparent" BorderThickness="0"
                         IsHitTestVisible="False"/>

            <!-- 关闭按钮（不打开，仅关闭） -->
            <Button x:Name="CloseButton" Width="26" Height="26" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip.Tip="关闭"
                    Click="OnCloseClick" PointerPressed="OnCloseButtonPointerPressed">
                <TextBlock Text="&#xE711;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="10" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</Window>
